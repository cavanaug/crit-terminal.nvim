#!/usr/bin/env bash
set -euo pipefail

if ! command -v crit >/dev/null 2>&1; then
  echo "crit-terminal: crit is required on PATH" >&2
  exit 1
fi

if ! command -v nvim >/dev/null 2>&1; then
  echo "crit-terminal: nvim is required on PATH" >&2
  exit 1
fi

if [[ $# -gt 1 ]]; then
  echo "usage: crit-terminal [file]" >&2
  exit 1
fi

FILE="${1:-}"
ABS_FILE=""
if [[ -n "$FILE" ]]; then
  if [[ "$FILE" = /* ]]; then
    ABS_FILE="$FILE"
  else
    ABS_FILE="$(pwd)/$FILE"
  fi
fi


daemon_port() {
  local status_json
  status_json="$(crit status --json 2>/dev/null || true)"
  if [[ -z "$status_json" ]]; then
    return 0
  fi

  if command -v python3 >/dev/null 2>&1; then
    STATUS_JSON="$status_json" python3 - <<'PY'
import json
import os

raw = os.environ.get("STATUS_JSON", "")
if not raw:
    raise SystemExit(0)

try:
    status = json.loads(raw)
except Exception:
    raise SystemExit(0)

daemon = status.get("daemon") or {}
port = daemon.get("port") if daemon.get("running") else None
if port:
    print(port)
PY
    return 0
  fi

  printf '%s\n' "$status_json" | awk '
    /"running"[[:space:]]*:[[:space:]]*true/ { running = 1 }
    running && match($0, /"port"[[:space:]]*:[[:space:]]*[0-9]+/) {
      print substr($0, RSTART, RLENGTH)
      exit
    }
  ' | awk -F: '{ gsub(/[[:space:]]/, "", $2); print $2 }'
}

if [[ -n "$ABS_FILE" ]]; then
  # Prefer plain review of the caller's file (not `crit plan`, which copies into ~/.crit/plans).
  crit --no-open "$ABS_FILE" >/dev/null 2>&1 &
elif [[ -z "$(daemon_port)" ]]; then
  crit --no-open >/dev/null 2>&1 &
fi

PORT=""
for _ in $(seq 1 50); do
  PORT="$(daemon_port)"
  if [[ -n "$PORT" ]]; then
    break
  fi
  sleep 0.1
done

if [[ -z "$PORT" ]]; then
  echo "crit-terminal: crit daemon did not become ready" >&2
  exit 1
fi

export CRIT_TERMINAL_BASE_URL="http://127.0.0.1:${PORT}"
export CRIT_TERMINAL_FILE="$ABS_FILE"

exec nvim \
  -c "lua require('crit').setup({ base_url = vim.env.CRIT_TERMINAL_BASE_URL })" \
  -c "lua require('crit').review({ file = vim.env.CRIT_TERMINAL_FILE ~= '' and vim.env.CRIT_TERMINAL_FILE or nil, base_url = vim.env.CRIT_TERMINAL_BASE_URL })"
